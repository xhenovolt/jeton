# Copy to .env.local and fill in. Never commit real values.

# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/jeton
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Passkeys / biometric login (recommended in production) ──
# WEBAUTHN_RP_ID=jeton.example.com
# WEBAUTHN_ORIGIN=https://jeton.example.com,https://www.jeton.example.com
# WEBAUTHN_RP_NAME=Jeton

# ── Encryption / signing ─────────────────────────────
ENCRYPTION_KEY=
CREDENTIALS_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
VERIFICATION_SECRET=

# ── Cloudinary (media uploads) ───────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── DRAIS integration ────────────────────────────────
DRAIS_PLATFORM_BASE_URL=
DRAIS_PLATFORM_TOKEN=
DRAIS_WEBHOOK_SECRET=
